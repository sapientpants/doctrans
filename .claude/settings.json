{
  "permissions": {
    "deny": [
      "Edit(/scripts/command-policy.sh)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/command-policy.sh\"",
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ]
  }
}
