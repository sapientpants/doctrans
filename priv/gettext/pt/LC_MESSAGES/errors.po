msgstr "Campos obrigatórios em falta: %{fields}"

#: lib/doctrans_web/error_messages.ex:9
#, elixir-autogen, elixir-format
msgid "Query too long (max %{max} characters)"
msgstr "Consulta demasiado longa (máximo de %{max} caracteres)"

#: lib/doctrans_web/error_messages.ex:6
#, elixir-autogen, elixir-format
msgid "Query too short"
msgstr "Consulta demasiado curta"

#: lib/doctrans_web/error_messages.ex:11
#, elixir-autogen, elixir-format
msgid "Search query must be a string"
msgstr "A consulta de pesquisa deve ser uma cadeia de caracteres"

#: lib/doctrans_web/error_messages.ex:40
