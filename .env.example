# Database configuration
DATABASE_HOST=db
DATABASE_URL=ecto://postgres:postgres@db/doctrans_dev

# Ollama configuration (points to host machine's Ollama)
# Use http://host.docker.internal:8000 for Docker on macOS/Windows
# Use http://172.17.0.1:8000 for Docker on Linux (or use host-gateway)
OPENAI_HOST=http://host.docker.internal:8000

# Storage root for originals, converted PDFs, and generated page images.
# Must be absolute. Unset, it defaults inside the application directory, which a
# release rebuild discards -- set it for any deployment whose data should
# survive. See "Storage root" in the README before moving an existing root, and
# "Backup and restore" for copying it. The runtime deployment sets it to
# /var/lib/doctrans on a named volume.
# DOCTRANS_DATA_DIR=/var/lib/doctrans

# Phoenix configuration
PHX_HOST=localhost
PORT=4000

# --- Runtime deployment (docker-compose.runtime.yml) -------------------------
# Read by Compose for variable substitution, not by the release's own .env
# loader: the runtime image mounts no source, so this file is not inside it.
# See "Runtime deployment" and "Backup and restore" in the README.

# Required by the compiled release, which refuses to start without it: signs
# cookies and LiveView sessions. Generate with `mix phx.gen.secret` and keep the
# value -- changing it invalidates every existing session.
# SECRET_KEY_BASE=

# Scheme the application advertises in generated URLs. Leave it http when the
# app serves HTTP directly; set https only when a TLS terminator runs in front,
# or the LiveView socket's origin check rejects every connection.
# PHX_SCHEME=http
