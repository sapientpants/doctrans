<!DOCTYPE html>
<html lang={assigns[:locale] || DoctransWeb.Locale.default()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Both descriptions come from `PrivacyCopy`: whether documents stay on this
    device is a configuration fact, and a hardcoded promise here would outlive the
    configuration it was true for. --%>
    <meta name="description" content={PrivacyCopy.meta_description()} />
    <meta property="og:title" content="Doctrans" />
    <meta property="og:description" content={PrivacyCopy.tagline()} />
    <.live_title default="Doctrans" suffix=" · Doctrans">
      {assigns[:page_title]}
    </.live_title>
    <%!-- Render-blocking, and ahead of the stylesheet: this applies the reader's
    saved theme to <html> before the first paint. `app.js` is deferred and runs
    too late for that. See assets/js/theme.js. --%>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme.js"}>
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
