[
  verbose: false,
  # `private: true` suppresses Sobelow's version-check phone-home and its write to
  # `~/.sobelow`. That is all this option does in 0.15.0 (`sobelow.ex:691`) — it is
  # unrelated to private functions, and Sobelow analyses `defp` either way. A quality
  # gate should not reach the network to run.
  private: true,
  # `skip: true` honours the `# sobelow_skip` annotations, each of which sits on the
  # function that owns the flagged call with a one-line justification above it. They are
  # load-bearing: turning `skip` off raises 23 findings, turning it on leaves 0.
  skip: true,
  router: "lib/doctrans_web/router.ex",
  # `exit: "low"` means every confidence level fails the build. The known-good sites
  # are annotated individually at the function that owns them, so a *new* finding —
  # including a low-confidence one — is a build failure rather than a line of noise.
  exit: "low",
  format: "txt",
  ignore: [
    # Config.CSP is a false positive, not a waiver. The `:browser` pipeline in
    # `lib/doctrans_web/router.ex` serves a strict `'self'`-only policy from
    # `DoctransWeb.ContentSecurityPolicy.headers/0`, but Sobelow 0.18.1 only recognises a
    # CSP written as a literal map in the `put_secure_browser_headers` call; it cannot
    # see through a function-call argument and reports "Config.CSP: Missing
    # Content-Security-Policy - Low Confidence" at router.ex:11, which `exit: "low"`
    # turns into a build failure. The policy itself is pinned by
    # `test/doctrans_web/content_security_policy_test.exs`, which is the gate that
    # would catch the header disappearing.
    #
    # What would invalidate this: Sobelow learning to evaluate the argument, at which
    # point the ignore should be dropped so the check runs for real.
    "Config.CSP",
    # Config.CSWH is a false positive of the same kind, not a waiver. The LiveView
    # socket's `check_origin` is an explicit allowlist (`//localhost`, `//127.0.0.1`,
    # `//[::1]`, plus PHX_HOST and a specific PHX_BIND_IP) built in `config/runtime.exs`
    # for every environment that serves; it has to live there because PHX_HOST and
    # PHX_BIND_IP are read at runtime. Sobelow 0.18.1 only trusts a literal list it can
    # read from `config/{config,prod,runtime}.exs`: a value computed inside the runtime
    # file's `if config_env() != :test` block is opaque to it, so it reports "Config.CSWH:
    # Cross-Site Websocket Hijacking - Low Confidence" on every `socket` in
    # `lib/doctrans_web/endpoint.ex`, and `# sobelow_skip` does not reach a `socket`
    # declaration. The allowlist itself is pinned by `test/doctrans/runtime_config_test.exs`
    # (never `false`, loopback-only by default, a foreign Origin refused through
    # `Phoenix.Socket.Transport.check_origin/5`) and `test/doctrans/dev_config_test.exs`
    # (dev.exs sets no `check_origin` of its own); those are the gates that would catch
    # the check being disabled again (#259).
    #
    # What would invalidate this: Sobelow learning to evaluate the runtime expression,
    # at which point the ignore should be dropped so the check runs for real.
    "Config.CSWH",
    # Config.HTTPS is correct to ignore for a loopback-bound, single-user app: there is
    # no TLS terminator to redirect to. See AGENTS.md on deployment-level exposure.
    "Config.HTTPS"
  ],
  ignore_files: []
]
