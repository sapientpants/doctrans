<Layouts.app flash={@flash}>
  <%= if @document do %>
    <div class="flex min-h-dvh flex-col bg-base-100 max-w-full fitscreen:h-dvh fitscreen:min-h-0 fitscreen:overflow-hidden">
      <%!-- Header --%>
      <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 pr-8 py-3 border-b border-base-300 bg-base-200">
        <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2">
          <.link
            navigate={back_url(@from, @search_query, @search_page)}
            class="btn btn-ghost btn-sm"
          >
            <.icon name="hero-arrow-left" class="w-5 h-5" /> {gettext("Back")}
          </.link>
          <div class="min-w-0">
            <h1 class="font-semibold text-lg break-words">{@document.title}</h1>
            <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/70">
              <span class={"badge badge-sm #{status_color(@document.status)}"}>
                {status_text(@document.status)}
              </span>
              <span :if={@document.total_pages}>
                {language_name(@document.target_language)}
              </span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            id="show-document-reprocess"
            type="button"
            phx-click="show_document_reprocess_modal"
            disabled={!@source_available || @document.status not in ~w(completed error)}
            aria-label={reprocess_document_hint(@source_available)}
            title={reprocess_document_hint(@source_available)}
            class="inline-flex items-center gap-2 rounded-lg border border-base-300 px-3 py-2 text-sm transition-colors hover:bg-base-300 disabled:cursor-not-allowed disabled:opacity-40"
          >
            <.icon name="hero-arrow-path" class="size-4" />
          </button>
          <.page_selector
            current_page={@current_page_number}
            total_pages={@document.total_pages || 0}
            document={@document}
          />
          <button
            id="toggle-chat"
            type="button"
            phx-click="toggle_chat"
            class={[
              "btn btn-sm",
              @chat_open && "btn-primary",
              !@chat_open && "btn-ghost"
            ]}
            aria-label={gettext("Chat with document")}
            aria-expanded={to_string(@chat_open)}
            aria-controls={@chat_open && "chat-panel"}
            title={gettext("Chat with document")}
          >
            <.icon name="hero-chat-bubble-left-right" class="w-5 h-5" />
            <span class="hidden sm:inline">{gettext("Chat")}</span>
          </button>

          <Layouts.theme_toggle />
        </div>
      </header>

      <section
        :if={@processing_progress < 100}
        class="border-b border-base-300 px-4 py-2"
        aria-label={gettext("Document processing")}
      >
        <.processing_progress
          id="document-processing-progress"
          document={@document}
          progress={@processing_progress}
          failed_pages={@failed_pages}
        />
        <p
          :if={!@source_available}
          id="original-upload-missing"
          class="text-xs text-base-content/60"
        >
          {gettext("Original upload unavailable. Re-upload this document to process it again.")}
        </p>
      </section>

      <%!-- Panel switcher - narrow viewports only (both panels show side by side at lg:) --%>
      <.view_tabs view_tab={@view_tab} show_original={@show_original} />

      <%!-- Main content - stacked tabs below lg, split screen at lg: and up --%>
      <div class="flex flex-1 flex-col lg:flex-row fitscreen:min-h-0 fitscreen:overflow-hidden">
        <%!-- Left panel - Page image --%>
        <div
          id="original-panel"
          class={[
            "w-full flex-col bg-base-200 transition-all duration-200",
            "lg:flex lg:border-r lg:border-base-300 fitscreen:min-h-0",
            if(@view_tab == :original, do: "flex", else: "hidden"),
            if(@chat_open, do: "lg:w-2/5", else: "lg:w-1/2")
          ]}
        >
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 border-b border-base-300">
            <span class="hidden text-sm font-medium lg:inline">{gettext("Original Page")}</span>
            <.zoom_controls zoom_level={@zoom_level} />
          </div>
          <div class="flex-1 p-4 flex items-start justify-center overflow-auto fitscreen:min-h-0">
            <.page_image page={@current_page} zoom_level={@zoom_level} />
          </div>
        </div>

        <%!-- Right panel - Translated content --%>
        <div
          id="translated-panel"
          class={[
            "w-full flex-col transition-all duration-200",
            "lg:flex fitscreen:min-h-0",
            if(@view_tab == :translated, do: "flex", else: "hidden"),
            if(@chat_open, do: "lg:w-2/5", else: "lg:w-1/2")
          ]}
        >
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 border-b border-base-300">
            <span class="hidden text-sm font-medium lg:inline">
              {content_panel_label(@show_original)}
            </span>
            <div class="flex items-center gap-2">
              <button
                :if={can_reprocess?(@current_page)}
                type="button"
                id="show-reprocess"
                phx-click="show_reprocess_modal"
                class="btn btn-ghost btn-xs"
                aria-label={gettext("Reprocess page")}
                title={gettext("Reprocess page")}
              >
                <.icon name="hero-arrow-path" class="w-4 h-4" />
              </button>
              <label class="flex items-center gap-2 cursor-pointer">
                <span class="text-xs text-base-content/70">{gettext("Show Original")}</span>
                <input
                  type="checkbox"
                  class="toggle toggle-sm"
                  checked={@show_original}
                  phx-click="toggle_original"
                />
              </label>
            </div>
          </div>
          <.page_provenance page={@current_page} />
          <div class="flex-1 p-6 overflow-auto fitscreen:min-h-0">
            <.page_content page={@current_page} show_original={@show_original} />
          </div>
        </div>

        <%!-- Chat panel - fixed overlay below lg, in-flow sidebar at lg: and up --%>
        <.chat_panel
          :if={@chat_open}
          chat_messages={@streams.chat_messages}
          chat_loading={@chat_loading}
          chat_interrupted={@chat_interrupted}
          chat_stage={@chat_stage}
          chat_streaming_content={@chat_streaming_content}
          embeddings_ready={@embeddings_ready}
        />
      </div>

      <%!-- Footer - Navigation --%>
      <.navigation current_page_number={@current_page_number} total_pages={@document.total_pages} />
    </div>

    <%!-- Reprocess Modal --%>
    <.reprocess_modal
      :if={@show_reprocess_modal}
      page={@current_page}
      document={@document}
      scope={@reprocess_scope}
      return_focus={
        if(@reprocess_scope == :document, do: "#show-document-reprocess", else: "#show-reprocess")
      }
      form={@reprocess_form}
      available_models={@available_models}
      models_loading={@models_loading}
      model_fetch_error={@model_fetch_error}
    />
  <% else %>
    <main
      id="document-not-found"
      class="flex min-h-[60vh] flex-col items-center justify-center gap-6 px-6 text-center"
    >
      <.icon name="hero-document-magnifying-glass" class="size-12 text-base-content/40" />
      <h1 class="text-2xl font-semibold tracking-tight">
        {ErrorMessages.message(:document_not_found)}
      </h1>
      <.link
        id="document-not-found-home"
        navigate={~p"/"}
        class="inline-flex items-center gap-2 rounded-lg px-4 py-2 font-medium text-primary transition-colors hover:bg-primary/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <.icon name="hero-arrow-left" class="size-5" />
        {gettext("Documents")}
      </.link>
    </main>
  <% end %>
</Layouts.app>
