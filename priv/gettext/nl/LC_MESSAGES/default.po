#, elixir-autogen, elixir-format
msgid "Reprocess document"
msgstr "Document opnieuw verwerken"

#: lib/doctrans_web/live/document_live/reprocess_modal.ex:210
#, elixir-autogen, elixir-format
msgid "Run every processing step again from the original upload. Existing pages and search results will be replaced. This may take some time."
msgstr "Voer alle verwerkingsstappen opnieuw uit met het oorspronkelijke bestand. Bestaande pagina’s en zoekresultaten worden vervangen. Dit kan even duren."

#: lib/doctrans_web/error_messages.ex:122
#, elixir-autogen, elixir-format
msgid "The document has changed. Please try again."
msgstr "Het document is gewijzigd. Probeer het opnieuw."

#: lib/doctrans_web/error_messages.ex:120
#, elixir-autogen, elixir-format
msgid "This document still has active processing jobs. Please wait for them to finish."
msgstr "Er zijn nog verwerkingstaken actief voor dit document. Wacht tot deze zijn afgerond."

#: lib/doctrans_web/live/document_live/reprocess_modal.ex:178
#, elixir-autogen, elixir-format
msgid "Select a model"
msgstr "Selecteer een model"

#: lib/doctrans_web/live/document_live/components.ex:95
#, elixir-autogen, elixir-format
msgid "Some pages could not be processed. Reprocess the failed pages, or the whole document once its jobs have finished."
msgstr "Sommige pagina's konden niet worden verwerkt. Verwerk de mislukte pagina's opnieuw, of het hele document zodra de taken zijn voltooid."
