msgstr "Il processo LibreOffice è terminato inaspettatamente"

#: lib/doctrans_web/error_messages.ex:46
#, elixir-autogen, elixir-format
msgid "The model did not return complete final text. Use a model with a larger output budget or split the page into smaller sections, then reprocess. The provider must return finish_reason=stop."
msgstr "Il modello non ha restituito un testo finale completo. Usa un modello con un limite di output maggiore oppure dividi la pagina in sezioni più piccole, quindi elaborala di nuovo. Il fornitore deve restituire finish_reason=stop."

#: lib/doctrans_web/error_messages.ex:69
#, elixir-autogen, elixir-format
msgid "Processing failed on page(s) %{page_numbers}. Reprocess those pages to finish this document."
msgstr "L'elaborazione non è riuscita alle pagine %{page_numbers}. Rielabora quelle pagine per completare questo documento."

#: lib/doctrans_web/error_messages.ex:96
#, elixir-autogen, elixir-format
msgid "PDF rendering timed out. Lower the extraction resolution or split the document, then try again."
msgstr "Il rendering del PDF è scaduto. Riduci la risoluzione di estrazione o dividi il documento, quindi riprova."

#: lib/doctrans_web/error_messages.ex:137
#, elixir-autogen, elixir-format
msgid "Page %{page_number} rendered too large (%{size} bytes, limit %{limit}). Lower the extraction resolution, then reprocess this page."
msgstr "La pagina %{page_number} è stata generata troppo grande (%{size} byte, limite %{limit}). Riduci la risoluzione di estrazione, quindi rielabora questa pagina."

#: lib/doctrans_web/error_messages.ex:147
#, elixir-autogen, elixir-format
msgid "Required PDF tool %{command} is not installed"
msgstr "Lo strumento PDF richiesto %{command} non è installato"

#: lib/doctrans_web/error_messages.ex:117
#, elixir-autogen, elixir-format
msgid "This PDF has %{pages} pages, above the limit of %{limit}. Split it into smaller documents before uploading."
msgstr "Questo PDF ha %{pages} pagine, oltre il limite di %{limit}. Dividilo in documenti più piccoli prima di caricarlo."

#: lib/doctrans_web/error_messages.ex:110
#, elixir-autogen, elixir-format
msgid "Extraction ran out of time for this document. Finished pages were kept; reprocess it to continue."
msgstr "Il tempo per l’estrazione di questo documento è scaduto. Le pagine completate sono state mantenute; rielaboralo per continuare."

#: lib/doctrans_web/error_messages.ex:103
#, elixir-autogen, elixir-format
msgid "Reading the PDF timed out before extraction started. The file may be damaged."
msgstr "La lettura del PDF è scaduta prima dell’inizio dell’estrazione. Il file potrebbe essere danneggiato."

#: lib/doctrans_web/error_messages.ex:126
#, elixir-autogen, elixir-format
msgid "This PDF's pages are %{width}x%{height} pixels at %{dpi} DPI, above the limit of %{limit} pixels. Lower the extraction resolution, then try again."
msgstr "Le pagine di questo PDF sono di %{width}x%{height} pixel a %{dpi} DPI, oltre il limite di %{limit} pixel. Riduci la risoluzione di estrazione e riprova."
