# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
doctrans-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# Ignore uploaded files (user data)
/priv/static/uploads/

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Dialyzer PLT files
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Claude Code local settings (user-specific)
.claude/settings.local.json

# Agent worktrees. An agent asked to work in isolation gets a full checkout of
# the repo here, so a run that ends without cleaning up leaves a second tree of
# the whole project -- ~100MB and several thousand files -- sitting untracked in
# every `git status`. Scratch space, never work product.
.claude/worktrees/

# Per-developer agent config. The shared guidelines live in AGENTS.md, which
# every agent reads; these two are each one developer's own tooling on top.
/CLAUDE.md
/opencode.jsonc

# Playwright MCP screenshots
.playwright-mcp/

# Environment files (may contain secrets)
.env
.env.local
.env.gpg
