#: lib/doctrans_web/error_messages.ex:305
#, elixir-autogen, elixir-format
msgid "Could not read uploaded file"
msgstr "Impossibile leggere il file caricato"

#: lib/doctrans_web/error_messages.ex:325
#, elixir-autogen, elixir-format
msgid "File too large (%{size}MB, max %{max}MB)"
msgstr "File troppo grande (%{size}MB, massimo %{max}MB)"

#: lib/doctrans_web/error_messages.ex:209
#, elixir-autogen, elixir-format
msgid "LibreOffice process terminated unexpectedly"
msgstr "Il processo LibreOffice è terminato inaspettatamente"

#: lib/doctrans_web/error_messages.ex:67
#, elixir-autogen, elixir-format
msgid "The model did not return complete final text. Use a model with a larger output budget or split the page into smaller sections, then reprocess. The provider must return finish_reason=stop."
msgstr "Il modello non ha restituito un testo finale completo. Usa un modello con un limite di output maggiore oppure dividi la pagina in sezioni più piccole, quindi elaborala di nuovo. Il fornitore deve restituire finish_reason=stop."

#: lib/doctrans_web/error_messages.ex:105
#, elixir-autogen, elixir-format
msgid "Processing failed on page(s) %{page_numbers}. Reprocess those pages to finish this document."
msgstr "L'elaborazione non è riuscita alle pagine %{page_numbers}. Rielabora quelle pagine per completare questo documento."

#: lib/doctrans_web/error_messages.ex:136
#, elixir-autogen, elixir-format
msgid "PDF rendering timed out. Lower the extraction resolution or split the document, then try again."
msgstr "Il rendering del PDF è scaduto. Riduci la risoluzione di estrazione o dividi il documento, quindi riprova."

#: lib/doctrans_web/error_messages.ex:177
#, elixir-autogen, elixir-format
msgid "Page %{page_number} rendered too large (%{size} bytes, limit %{limit}). Lower the extraction resolution, then reprocess this page."
msgstr "La pagina %{page_number} è stata generata troppo grande (%{size} byte, limite %{limit}). Riduci la risoluzione di estrazione, quindi rielabora questa pagina."

#: lib/doctrans_web/error_messages.ex:187
#, elixir-autogen, elixir-format
msgid "Required PDF tool %{command} is not installed"
msgstr "Lo strumento PDF richiesto %{command} non è installato"

#: lib/doctrans_web/error_messages.ex:157
#, elixir-autogen, elixir-format
msgid "This PDF has %{pages} pages, above the limit of %{limit}. Split it into smaller documents before uploading."
msgstr "Questo PDF ha %{pages} pagine, oltre il limite di %{limit}. Dividilo in documenti più piccoli prima di caricarlo."

#: lib/doctrans_web/error_messages.ex:150
#, elixir-autogen, elixir-format
msgid "Extraction ran out of time for this document. Finished pages were kept; reprocess it to continue."
msgstr "Il tempo per l’estrazione di questo documento è scaduto. Le pagine completate sono state mantenute; rielaboralo per continuare."

#: lib/doctrans_web/error_messages.ex:143
#, elixir-autogen, elixir-format
msgid "Reading the PDF timed out before extraction started. The file may be damaged."
msgstr "La lettura del PDF è scaduta prima dell’inizio dell’estrazione. Il file potrebbe essere danneggiato."

#: lib/doctrans_web/error_messages.ex:166
#, elixir-autogen, elixir-format
msgid "This PDF's pages are %{width}x%{height} pixels at %{dpi} DPI, above the limit of %{limit} pixels. Lower the extraction resolution, then try again."
msgstr "Le pagine di questo PDF sono di %{width}x%{height} pixel a %{dpi} DPI, oltre il limite di %{limit} pixel. Riduci la risoluzione di estrazione e riprova."

#: lib/doctrans_web/error_messages.ex:308
#, elixir-autogen, elixir-format
msgid "Could not store the uploaded file"
msgstr "Impossibile salvare il file caricato"

#: lib/doctrans_web/error_messages.ex:321
#, elixir-autogen, elixir-format
msgid "The document could not be saved"
msgstr "Impossibile salvare il documento"

#: lib/doctrans_web/error_messages.ex:311
#, elixir-autogen, elixir-format
msgid "Could not start processing for this document"
msgstr "Impossibile avviare l'elaborazione di questo documento"

#: lib/doctrans_web/error_messages.ex:117
#, elixir-autogen, elixir-format
msgid "Only PDF, Word, OpenDocument, and RTF documents are accepted"
msgstr "Sono accettati solo documenti PDF, Word, OpenDocument e RTF"

#: lib/doctrans_web/error_messages.ex:316
#, elixir-autogen, elixir-format
msgid "This file could not be uploaded. Please try again."
msgstr "Non è stato possibile caricare questo file. Riprova."

#: lib/doctrans_web/error_messages.ex:74
#, elixir-autogen, elixir-format
msgid "The model server ran out of time and the request was stopped. Check that it is running and responsive, then reprocess this page."
msgstr "Il server dei modelli ha esaurito il tempo a disposizione e la richiesta è stata interrotta. Verifica che sia in esecuzione e che risponda, quindi rielabora questa pagina."

#: lib/doctrans_web/error_messages.ex:81
#, elixir-autogen, elixir-format
msgid "The model server's answer went past the %{limit} byte limit and was stopped before it was read. Check the configured model and endpoint, then try again."
msgstr "La risposta del server dei modelli ha superato il limite di %{limit} byte ed è stata interrotta prima di essere letta. Verifica il modello e l'endpoint configurati, quindi riprova."

#: lib/doctrans_web/error_messages.ex:61
#, elixir-autogen, elixir-format
msgid "Source language is required and must be a string"
msgstr "La lingua di origine è obbligatoria e deve essere una stringa"

#: lib/doctrans_web/error_messages.ex:239
#, elixir-autogen, elixir-format
msgid "No page of this document is waiting to be retried. Reload the page to see its current state."
msgstr "Nessuna pagina di questo documento è in attesa di un nuovo tentativo. Ricarica la pagina per vedere lo stato attuale."

#: lib/doctrans_web/error_messages.ex:232
#, elixir-autogen, elixir-format
msgid "This document has already finished processing, so there is nothing left to stop."
msgstr "L’elaborazione di questo documento è già terminata, quindi non c’è più nulla da interrompere."

#: lib/doctrans_web/error_messages.ex:279
#, elixir-autogen, elixir-format
msgid "The embedding model %{model} is not available on %{destination}. Documents will still translate, but they cannot be searched until it is loaded there or the embedding model names one that server offers."
msgstr "Il modello di embedding %{model} non è disponibile su %{destination}. I documenti verranno comunque tradotti, ma non saranno ricercabili finché non verrà caricato lì o finché il modello di embedding non indicherà uno tra quelli offerti da quel server."

#: lib/doctrans_web/error_messages.ex:296
#, elixir-autogen, elixir-format
msgid "The embedding model %{model} returns %{actual} dimensions, but %{expected} are required. Choose an embedding model with at least %{expected} dimensions; until then documents translate but cannot be searched."
msgstr "Il modello di embedding %{model} restituisce %{actual} dimensioni, ma ne servono %{expected}. Scegli un modello di embedding con almeno %{expected} dimensioni; fino ad allora i documenti vengono tradotti ma non sono ricercabili."

#: lib/doctrans_web/error_messages.ex:288
#, elixir-autogen, elixir-format
msgid "The embedding server at %{destination} is not answering. Documents will still translate, but they cannot be searched until it is running."
msgstr "Il server di embedding su %{destination} non risponde. I documenti verranno comunque tradotti, ma non saranno ricercabili finché non sarà in esecuzione."

#: lib/doctrans_web/error_messages.ex:259
#, elixir-autogen, elixir-format
msgid "The extraction model %{model} is not available on %{destination}. Load it there, or set the extraction model to one that server offers."
msgstr "Il modello di estrazione %{model} non è disponibile su %{destination}. Caricalo lì, oppure imposta come modello di estrazione uno tra quelli offerti da quel server."

#: lib/doctrans_web/error_messages.ex:251
#, elixir-autogen, elixir-format
msgid "The model server at %{destination} is not answering. Start it before uploading, or documents will wait in the queue until it is running."
msgstr "Il server dei modelli su %{destination} non risponde. Avvialo prima di caricare, altrimenti i documenti resteranno in coda finché non sarà in esecuzione."

#: lib/doctrans_web/error_messages.ex:268
#, elixir-autogen, elixir-format
msgid "The translation model %{model} is not available on %{destination}. Load it there, or set the translation model to one that server offers."
msgstr "Il modello di traduzione %{model} non è disponibile su %{destination}. Caricalo lì, oppure imposta come modello di traduzione uno tra quelli offerti da quel server."

#: lib/doctrans_web/error_messages.ex:22
#, elixir-autogen, elixir-format
msgid "An unexpected error occurred. Please try again."
msgstr "Si è verificato un errore imprevisto. Per favore riprova."

#: lib/doctrans_web/error_messages.ex:348
#, elixir-autogen, elixir-format
msgid "Could not fetch the list of models from the model server"
msgstr "Impossibile recuperare l'elenco dei modelli dal server dei modelli"

#: lib/doctrans_web/error_messages.ex:342
#, elixir-autogen, elixir-format
msgid "Document search is temporarily unavailable. Please try again."
msgstr "La ricerca nel documento non è temporaneamente disponibile. Riprova."

#: lib/doctrans_web/error_messages.ex:344
#, elixir-autogen, elixir-format
msgid "Failed to delete document"
msgstr "Impossibile eliminare il documento"

#: lib/doctrans_web/error_messages.ex:345
#, elixir-autogen, elixir-format
msgid "Failed to reset page for reprocessing"
msgstr "Impossibile reimpostare la pagina per la rielaborazione"

#: lib/doctrans_web/error_messages.ex:334
#, elixir-autogen, elixir-format
msgid "Failed to search the document. Please try again."
msgstr "Impossibile cercare nel documento. Per favore riprova."

#: lib/doctrans_web/error_messages.ex:304
#, elixir-autogen, elixir-format
msgid "Invalid model selection"
msgstr "Selezione del modello non valida"

#: lib/doctrans_web/error_messages.ex:215
#, elixir-autogen, elixir-format
msgid "Original upload unavailable. Re-upload this document to process it again."
msgstr "Il file originale non è disponibile. Carica nuovamente il documento per elaborarlo di nuovo."

#: lib/doctrans_web/error_messages.ex:330
#, elixir-autogen, elixir-format
msgid "Please enter a question."
msgstr "Per favore inserisci una domanda."

#: lib/doctrans_web/error_messages.ex:337
#, elixir-autogen, elixir-format
msgid "Search is temporarily unavailable. Please try again."
msgstr "La ricerca non è temporaneamente disponibile. Per favore riprova."

#: lib/doctrans_web/error_messages.ex:228
#, elixir-autogen, elixir-format
msgid "The document has changed. Please try again."
msgstr "Il documento è stato modificato. Riprova."

#: lib/doctrans_web/error_messages.ex:222
#, elixir-autogen, elixir-format
msgid "This document still has active processing jobs. Please wait for them to finish."
msgstr "Questo documento ha ancora attività di elaborazione in corso. Attendi che terminino."
