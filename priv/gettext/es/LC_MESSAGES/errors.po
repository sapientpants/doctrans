#: lib/doctrans_web/error_messages.ex:46
#, elixir-autogen, elixir-format
msgid "The model did not return complete final text. Use a model with a larger output budget or split the page into smaller sections, then reprocess. The provider must return finish_reason=stop."
msgstr "El modelo no devolvió un texto final completo. Use un modelo con un límite de salida mayor o divida la página en secciones más pequeñas y vuelva a procesarla. El proveedor debe devolver finish_reason=stop."

#: lib/doctrans_web/error_messages.ex:69
#, elixir-autogen, elixir-format
msgid "Processing failed on page(s) %{page_numbers}. Reprocess those pages to finish this document."
msgstr "El procesamiento falló en la(s) página(s) %{page_numbers}. Vuelva a procesar esas páginas para terminar este documento."

#: lib/doctrans_web/error_messages.ex:96
#, elixir-autogen, elixir-format
msgid "PDF rendering timed out. Lower the extraction resolution or split the document, then try again."
msgstr "El renderizado del PDF ha superado el tiempo límite. Reduzca la resolución de extracción o divida el documento e inténtelo de nuevo."

#: lib/doctrans_web/error_messages.ex:112
#, elixir-autogen, elixir-format
msgid "Page %{page_number} rendered too large (%{size} bytes, limit %{limit}). Lower the extraction resolution, then reprocess this page."
msgstr "La página %{page_number} se generó demasiado grande (%{size} bytes, límite %{limit}). Reduzca la resolución de extracción y vuelva a procesar esta página."

#: lib/doctrans_web/error_messages.ex:122
#, elixir-autogen, elixir-format
msgid "Required PDF tool %{command} is not installed"
msgstr "La herramienta PDF requerida %{command} no está instalada"

#: lib/doctrans_web/error_messages.ex:103
#, elixir-autogen, elixir-format
msgid "This PDF has %{pages} pages, above the limit of %{limit}. Split it into smaller documents before uploading."
msgstr "Este PDF tiene %{pages} páginas, por encima del límite de %{limit}. Divídalo en documentos más pequeños antes de subirlo."
